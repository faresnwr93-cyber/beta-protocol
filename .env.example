# Application Discord (les identifiants restent exclusivement côté serveur)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=1250451718454513805
BETA_ROLE_ID=1565747598281936946 # PASS BETA sur Protocol Z: Origins

# URL exacte à enregistrer dans le Developer Portal Discord
REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Autorisation : une entrée de la liste OU le rôle prérequis suffit.
AUTHORIZED_DISCORD_IDS=
REQUIRED_ROLE_ID=
ALLOW_PUBLIC_CLAIMS=false

# Obligatoire en production : journal privé des attributions réussies.
DISCORD_LOG_WEBHOOK_URL=

# Liens affichés dans l'interface. Renseignez votre invitation réelle.
DISCORD_INVITE_URL=https://discord.gg/VOTRE-INVITATION
RULES_URL=https://protocol-z-origins.github.io/survival-protocol/

# Générez une clé aléatoire d'au moins 32 caractères pour NEXTAUTH_SECRET.
NEXTAUTH_SECRET=

# Requis en production pour rate limiting et unicité durables (Upstash Redis REST).
# En développement local, une mémoire temporaire du processus est utilisée.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
